# SafeShare AI - Environment Variables
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://safeshare:safeshare_pass@localhost:5432/safeshare_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SECRET_KEY=change-this-in-production-use-a-real-256-bit-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://127.0.0.1:5500","http://localhost:5500","http://localhost:5173","null"]

TESSERACT_CMD=/usr/bin/tesseract
MAX_IMAGE_SIZE_MB=10
MAX_UPLOAD_SIZE_MB=50
LOG_LEVEL=INFO
